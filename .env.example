# Public site URL (used for canonical links, sitemap, structured data)
VITE_SITE_URL=https://www.avenixltd.cloud

# Contact form: HTTPS endpoint that accepts a JSON POST (e.g. Formspree, Web3Forms, or your own API).
# Leave empty until a real endpoint exists. The form will then report honestly that it is not connected.
VITE_CONTACT_ENDPOINT=

# Easiest way to receive enquiries by email: get a free access key at https://web3forms.com
# (enter jangosoftltd@gmail.com; the key is emailed to you), then paste it here.
VITE_WEB3FORMS_KEY=

# Set to true to hide the draft (not yet client-approved) testimonials in a build.
VITE_HIDE_DRAFT_TESTIMONIALS=false
